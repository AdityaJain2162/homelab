# Vault server config — single-node raft storage, TLS listener with web UI.
# Used by node1/docker-compose.yml. TLS certs generated by scripts/vault-tls.sh
# into /opt/docker/appdata/vault/tls/ (not committed — self-signed, local CA).

storage "raft" {
  path    = "/vault/data"
  node_id = "node1"
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "/vault/tls/vault.crt"
  tls_key_file  = "/vault/tls/vault.key"
}

# Single node — cluster_addr only matters once HA is added.
api_addr     = "https://vault.homelab:8200"
cluster_addr = "https://vault.homelab:8201"

ui = true

default_lease_ttl = "768h"   # 32 days
default_max_lease_ttl = "8760h"  # 1 year
