# Node 1 environment — copy to .env and fill in real values.
# .env is gitignored; this file is the committed template.

# Container user/group + timezone
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Identity — TODO: set real values. Currently flat LAN; moves to Management
# VLAN (docs/network.md) when VLANs are configured on the ER605.
NODE1_NAME=node1
NODE1_IP=192.168.1.60
LAN_SUBNET=192.168.1.0/24

# Node 2 — needed only when the parked alloy log shipper is enabled
# NODE2_IP=192.168.1.61

# Tailscale — optional headless auth; otherwise run:
#   docker compose exec tailscale tailscale up
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# MQTT credentials — source of truth for Mosquitto auth.
# Node 2 services (Frigate, Zigbee2MQTT) reuse these same values.
# Create the passwordfile first (see node1/README.md deploy steps), then uncomment:
# MQTT_USER=mqtt
# MQTT_PASSWORD=change-me

# Grafana admin — UI on :3002, datasource auto-provisioned to VictoriaMetrics.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Service ports — PUBLISHED host ports (bridge networking). Container-internal
# ports stay at app defaults, so LAN clients + Node 2 use these; compose service
# names keep working internally regardless of the values here.
NODE_EXPORTER_PORT=9100
VICTORIAMETRICS_PORT=8428
CADVISOR_PORT=8080
BLACKBOX_PORT=9115
GRAFANA_PORT=3002          # host :3000 is AdGuard, :3001 is Uptime Kuma (parked)
HOMEPAGE_PORT=3003         # service tiles page — :3003 was freed when NPM went bridge
# Hosts allowed to reach Homepage (Host-header check). Add your access names:
HOMEPAGE_ALLOWED_HOSTS=home.homelab,192.168.1.60:3003

# NPM API token — for scripts/npm-sync.py (git-managed proxy hosts).
# Create in NPM UI: User → Tokens → Create Token, then paste here.
# NPM_API_TOKEN=

# Ports NOT settable here (live in each app's own config):
#   AdGuard   :53 DNS + :3000 UI  → node1/config/adguard/AdGuardHome.yaml (host network)
#   Home Asst :8123               → published 8123:8123; internal port in configuration.yaml
#   NPM       :80/:443/:81        → published above; backend API :3000 inside container
