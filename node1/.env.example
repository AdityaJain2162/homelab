PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Optional — Tailscale headless auth (otherwise run `docker compose exec tailscale tailscale up`)
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Needed only when Zigbee2MQTT is enabled — same credentials as the Mosquitto passwordfile
# MQTT_USER=mqtt
# MQTT_PASSWORD=change-me
