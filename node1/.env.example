# Node 1 environment — copy to .env and fill in real values.
# .env is gitignored; this file is the committed template.

PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Node 1's LAN IP — feeds Homepage links, npm-sync backends, AdGuard seed.
NODE1_IP=192.168.1.60

# Grafana admin — UI on :3002, datasource auto-provisioned.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Published host ports (bridge networking). Container-internal ports stay at
# app defaults; these only change if something else owns the host port.
NODE_EXPORTER_PORT=9100
VICTORIAMETRICS_PORT=8428
CADVISOR_PORT=8080
BLACKBOX_PORT=9115
GRAFANA_PORT=3002
HOMEPAGE_PORT=3003

# Hosts allowed to reach Homepage (Host-header check).
HOMEPAGE_ALLOWED_HOSTS=home.homelab,192.168.1.60:3003

# ── Optional — uncomment as needed ──────────────────────────────

# Node 2 — feeds Homepage Node-2 links, npm-sync backends, parked alloy.
# NODE2_IP=192.168.1.61

# NPM admin creds — for scripts/npm-sync.py (git-managed proxy hosts).
# NPM_USER=admin@example.com
# NPM_PASSWORD=change-me

# MQTT — source of truth for Mosquitto auth; Node 2 services reuse these.
# MQTT_USER=mqtt
# MQTT_PASSWORD=change-me

# Tailscale — headless auth; otherwise `docker compose exec tailscale tailscale up`.
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Ports NOT settable here — they live in each app's own config:
#   AdGuard :53 + :3000 (host network) · Home Assistant :8123 · NPM :80/:443/:81
