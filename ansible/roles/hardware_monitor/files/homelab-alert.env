# /etc/homelab-alert.env — hardware alert targets, root:root 600.
# Deployed by ansible role hardware_monitor ONLY if missing — edit on the node.
# Fill at least one target, then: systemctl restart smartmontools

# Telegram — create a bot via @BotFather, get token; chat_id via @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord — channel → Edit Channel → Integrations → Webhooks → copy URL
# DISCORD_WEBHOOK_URL=
