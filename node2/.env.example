# Node 2 environment — copy to .env and fill in real values.
# .env is gitignored; this file is the committed template.

# Container user/group + timezone
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Identity — TODO: set real values. Node 1 IP is live; Node 2 TBD at purchase.
# Currently flat LAN; moves to Management VLAN (docs/network.md) later.
NODE1_NAME=node1
NODE1_IP=192.168.1.60
NODE2_NAME=node2
NODE2_IP=192.168.1.61

# Alloy's scrape target for Node 1's node-exporter — keep in sync with NODE1_IP
NODE1_EXPORTER_ADDR=192.168.1.60:9100

# Secondary DNS (compose/dns.yml) — web UI port, set as bind_port in the
# imported AdGuardHome.yaml (:3000 is Grafana on this node). DNS is always :53.
# Keep AdGuard settings in sync with the Node 1 instance (export/import AdGuardHome.yaml).
ADGUARD_WEB_PORT=3001

# Grafana admin password (required — compose fails fast if unset)
GRAFANA_ADMIN_PASSWORD=change-me

# Monitoring stack ports — host networking, bind directly on NODE2_IP.
# Keep config/alloy/config.alloy + grafana datasource URLs in sync if changed.
VICTORIAMETRICS_PORT=8428
GRAFANA_PORT=3000          # Node 2 Grafana owns :3000 — AdGuard web is :3001
CADVISOR_PORT=8085         # :8080 is qBittorrent (media.yml)
NODE_EXPORTER_PORT=9100
ALLOY_PORT=12345
# LOKI_PORT=3100            # set in config/loki/loki.yaml http_listen_port

# Immich
IMMICH_VERSION=v3.3.6
UPLOAD_LOCATION=/srv/photos
DB_DATA_LOCATION=/opt/docker/appdata/immich/postgres
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Gluetun / VPN provider — pick one and fill credentials,
# see https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
# SERVER_COUNTRIES=
# WIREGUARD_PRIVATE_KEY=
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# Frigate → Mosquitto on Node 1:
# auth values live in node1/.env (MQTT_USER / MQTT_PASSWORD) — the source of
# truth. Frigate's config.yml takes them as literal values; keep in sync.
# MQTT_HOST=192.168.1.60
