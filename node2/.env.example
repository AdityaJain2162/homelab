PUID=1000
PGID=1000
TZ=Asia/Kolkata

# --- Immich (compose/immich.yml) ---
IMMICH_VERSION=v3.3.6
UPLOAD_LOCATION=/srv/photos
DB_DATA_LOCATION=/opt/docker/appdata/immich/postgres
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Gluetun (compose/media.yml) ---
# Pick a provider and fill its credentials — see https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
# SERVER_COUNTRIES=Netherlands
# WIREGUARD_PRIVATE_KEY=...
# OPENVPN_USER=...
# OPENVPN_PASSWORD=...

# --- Frigate MQTT (compose/frigate.yml) — Mosquitto lives on Node 1 ---
# MQTT_HOST=<node1-ip>
# MQTT_USER=mqtt
# MQTT_PASSWORD=change-me
